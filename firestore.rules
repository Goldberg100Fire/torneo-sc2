rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function adminRoles() {
      return get(/databases/$(database)/documents/torneos_sc2/admin_roles);
    }

    function rolesExist() {
      return exists(/databases/$(database)/documents/torneos_sc2/admin_roles);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /** Debe coincidir con bootstrapSuperAdminEmails en firebase-config.js */
    function bootstrapSuperEmails() {
      return ['geylquimichen@ucvvirtual.edu.pe', 'geylquimichen@gmail.com'];
    }

    function isBootstrapSuperEmail() {
      return isSignedIn() && request.auth.token.email in bootstrapSuperEmails();
    }

    function isSuperAdmin() {
      return isSignedIn() && rolesExist() &&
        request.auth.uid in adminRoles().data.superAdminUids;
    }

    function isEditor() {
      return isSignedIn() && rolesExist() &&
        request.auth.uid in adminRoles().data.editorUids;
    }

    function canWriteTournament() {
      return isSuperAdmin() || isEditor();
    }

    /** Primer acceso: correo bootstrap puede escribir admin_roles (alta o reintento). */
    function canBootstrapSuperWrite() {
      return isSignedIn()
        && isBootstrapSuperEmail()
        && request.auth.uid in request.resource.data.get('superAdminUids', []);
    }

    function isBootstrapSuperSelfRegister() {
      return canBootstrapSuperWrite()
        && (!rolesExist()
          || !(request.auth.uid in adminRoles().data.get('superAdminUids', [])));
    }

    match /torneos_sc2/principal {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /torneos_sc2/admin_roles {
      allow read: if isSignedIn();
      allow create: if canBootstrapSuperWrite()
        || request.auth.uid in request.resource.data.get('superAdminUids', []);
      allow update: if isSuperAdmin()
        || canBootstrapSuperWrite()
        || (isSignedIn()
          && request.auth.uid in request.resource.data.editorUids
          && !(request.auth.uid in resource.data.get('editorUids', [])));
    }

    match /torneos_sc2/{docId} {
      allow read: if true;
      allow create: if docId.matches('ut_.*')
        && request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;
      allow update: if docId == 'principal' && isSuperAdmin()
        || (docId.matches('ut_.*')
          && request.auth != null
          && request.auth.uid == resource.data.ownerUid)
        || (docId.matches('ut_.*') && isSuperAdmin());
      allow delete: if docId.matches('ut_.*')
        && request.auth != null
        && (request.auth.uid == resource.data.ownerUid || isSuperAdmin());
    }
  }
}
